[
  {
    "name": "gitlab-registry-secret",
    "namespace": "default",
    "data": {
      ".dockerconfigjson": {
        "auths": {
          "gitlab.nam.cz:5050": {
            "username": "GTL_USER",
            "password": "GTL_TOKEN",
            "email": "GTL_USER_EMAIL",
            "auth": "GTL_AUTH"
          }
        }
      }
    }
  },
  {
    "name": "s3-secret",
    "namespace": "default",
    "data": {
      "s3AccessKey": "S3_ACCESS_KEY",
      "s3Secret": "S3_SECRET_KEY"
    }
  },
  {
    "name": "postgres-secret",
    "namespace": "default",
    "data": {
      "dbPass": "PG_PASS",
      "dbUser": "PG_USER"
    }
  },
  {
    "name": "postgres-dbowner-secret",
    "namespace": "default",
    "data": {
      "dbOwnerPass": "PG_DB_OWNER_PASS",
      "dbOwner": "PG_DB_OWNER"
    }
  },
  {
    "name": "postgres-superuser-secret",
    "namespace": "default",
    "data": {
      "dbSuperUserPass": "PG_SUPER_USER_PASS",
      "dbSuperUser": "PG_SUPER_USER"
    }
  }
]

